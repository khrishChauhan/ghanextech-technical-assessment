# Groq Cloud API Key
# Obtain a free key from https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Optional GitHub Personal Access Token (PAT)
# Unauthenticated requests are limited to 60 req/hr; with PAT it increases to 5,000 req/hr.
# Generate a fine-grained or classic token with public repo read access: https://github.com/settings/tokens
GITHUB_TOKEN=optional_github_personal_access_token_here
